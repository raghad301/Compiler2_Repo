<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <script src="{{ url_for('static', filename='script.js') }}" defer></script>
</head>
<body data-page="details">
    <main class="container narrow">
        <a class="back-link" href="{{ url_for('index') }}">Back to Products</a>
        <h1>Product Details</h1>

        <article id="product-details" class="product-card details-card" data-product-id="{{ product.id }}">
            {% if product %}
                <img id="product-image"
                     class="product-image large"
                     src="{{ url_for('static', filename='pics/' + product.image) }}"
                     alt="{{ product.name }}">
            {% else %}
                <img id="product-image" class="product-image large" alt="">
            {% endif %}
            <h2 id="product-name">{{ product.name }}</h2>
            <p id="product-price" class="price">${{ product.price }}</p>
            <p id="product-image-name" class="muted">Image: {{ product.image }}</p>
            <nav class="card-actions">
                <a id="edit-product-link" href="{{ url_for('edit_product', product_id=product.id) }}">Edit Product</a>
            </nav>
        </article>
    </main>
</body>
</html>
