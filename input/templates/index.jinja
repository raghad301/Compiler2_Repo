<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <script src="{{ url_for('static', filename='script.js') }}" defer></script>
</head>
<body data-page="index">
    <main class="container">
        <header class="page-header">
            <div>
                <p class="eyebrow">Compiler Store</p>
                <h1>Products List</h1>
            </div>
            <a class="button primary" href="{{ url_for('add_product') }}">Add New Product</a>
        </header>

        <section id="products-list" class="products" aria-label="Products">
            {% for product in products %}
            <article class="product-card" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}" data-product-price="{{ product.price }}" data-product-image="{{ product.image }}">
                <img class="product-image"
                     src="{{ url_for('static', filename='pics/' + product.image) }}"
                     alt="{{ product.name }}">
                <h2>{{ product.name }}</h2>
                <p class="price">${{ product.price }}</p>
                <nav class="card-actions" aria-label="Actions for {{ product.name }}">
                    <a href="{{ url_for('product_details', product_id=product.id) }}">Details</a>
                    <a href="{{ url_for('edit_product', product_id=product.id) }}">Edit</a>
                    <a class="danger delete-link" href="{{ url_for('delete_product', product_id=product.id) }}">Delete</a>
                </nav>
            </article>
            {% endfor %}
        </section>

        <p id="empty-state" class="empty-state" hidden>No products available.</p>
    </main>
</body>
</html>
